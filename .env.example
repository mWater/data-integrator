# mWater Data Integrator configuration. Copy to .env and run with:
#   node --env-file=.env apps/server/dist/cli.js serve
# Deployments load the same variables from /etc/data-integrator/env (systemd
# EnvironmentFile; see deploy/). All variables are read and validated once at
# startup in apps/server/src/config.ts. Only DATABASE_URL is required.
# Deployment behavior that admins change at runtime (default area of interest,
# etc.) lives in the settings UI, not here.

# --- Required ---

# Postgres connection URL (PostGIS enabled)
DATABASE_URL=postgres://postgres:changeme@127.0.0.1:15432/postgres

# --- Server ---

# HTTP port for `serve` (default 8080)
#PORT=8080

# Built SPA directory (default: apps/ui/dist relative to the server build)
#UI_DIST_PATH=

# Live Vite origin. `pnpm dev` sets this so PORT serves the hot-reloading UI
# instead of the last build. Unset for production (`serve` the dist).
#VITE_DEV_URL=

# --- Storage paths ---

# Raster snapshot files (default ./raster-store). The Postgres server process
# must be able to read this path (out-db SQL registration) or runs fail.
#RASTER_STORE_PATH=./raster-store

# Per-integration persistent /work directories (default ./work)
#WORK_ROOT=./work

# Rendered tile + basemap cache (default ./tile-cache)
#TILE_CACHE_PATH=./tile-cache

# Uploaded integration files, every version kept (default ./file-store); see
# docs/Integration Files.md
#FILE_STORE_PATH=./file-store
# Largest accepted upload in megabytes (default 100). A proxy in front must
# allow at least this much: Cloudflare caps request bodies at 100 MB on its
# Free and Pro plans, nginx at 1 MB unless client_max_body_size is raised
#FILE_UPLOAD_MAX_MB=100

# Disk protection (megabytes; 0 disables the guard)
# Per-integration /work ceiling and default: a definition's workDiskMb may
# lower it but never exceed it; over-quota jobs are killed mid-run (default 20480)
#WORK_QUOTA_MB=20480
# Per-run /tmp ceiling and default: temporary disk under the work root, removed
# after each run; a definition's tmpDiskMb may lower it (default 20480)
#TMP_QUOTA_MB=20480
# Free-space floor on the work root and raster store filesystems: runs refuse
# to start below it and running jobs are killed when it is crossed (default 2048)
#MIN_FREE_DISK_MB=2048
# Tile + basemap cache budget, oldest files evicted on the scheduler's
# maintenance tick (default 1024)
#TILE_CACHE_MB=1024
# Map tile renders (GDAL subprocess pipelines, a few hundred MB each) allowed
# at once; further tile requests queue (default 3)
#TILE_RENDER_CONCURRENCY=3
# Job sandbox memory the host commits at once, summed over every running job's
# memoryMb (scheduled and design-session runs alike); further jobs wait.
# Default: physical RAM minus 2048, never below 2048. 0 disables the budget
#SANDBOX_MEMORY_MB=

# Ceilings on what one job may request; a definition's limits above them are
# lowered, with a line in the run log. 0 disables each
# CPU cores (default: the host's core count)
#JOB_MAX_CPUS=
# Memory in megabytes (default: SANDBOX_MEMORY_MB)
#JOB_MAX_MEMORY_MB=
# Wall-clock timeout in minutes (default 360)
#JOB_MAX_TIMEOUT_MIN=360

# Addresses jobs may not reach, beyond the private and link-local ranges that
# are always blocked: comma-separated IPv4/IPv6 addresses or CIDRs, such as
# this host's public IPs or other services of yours on the internet
#JOB_BLOCKED_ADDRESSES=

# Integration library root holding integrations/ and skills/ (default ./library)
#LIBRARY_PATH=./library

# --- Secrets ---

# 32-byte key (base64 or hex) encrypting integration secrets and the AI
# provider's API key at rest. Generate with: openssl rand -base64 32
# Needed once definitions declare secrets or an admin saves an AI API key.
#INTEGRATOR_SECRET_KEY=

# --- Job runtimes ---

# Container images for the sandboxed runtimes (defaults are the dev builds)
#RUNTIME_IMAGE_PYTHON=localhost/integrator-runtime-python:dev
#RUNTIME_IMAGE_NODE=localhost/integrator-runtime-node:dev

# --- Agent model (optional; core ingest/query works with none) ---

# The provider, API key and model are set by an admin in Settings, AI features,
# and stored encrypted under INTEGRATOR_SECRET_KEY. On a database with no AI
# settings yet, the first start copies OPENROUTER_API_KEY, ANTHROPIC_API_KEY,
# or LLM_BASE_URL/LLM_API_KEY (with AGENT_MODEL) from here into Settings; after
# that these variables are not read.

# Reasoning effort for OpenRouter models: xhigh | high | medium | low | minimal | none
#AGENT_EFFORT=

# --- Basemap proxy ---

# Upstream tile server; "off" disables the basemap (default OpenFreeMap)
#BASEMAP_UPSTREAM=https://tiles.openfreemap.org
#BASEMAP_STYLE_LIGHT=styles/positron
#BASEMAP_STYLE_DARK=styles/dark
