{
  "openapi": "3.1.0",
  "info": {
    "title": "mWater Data Integrator API",
    "version": "1.0.0",
    "description": "Programmatic interface to the harmonized dataset: tabular destinations, the raster catalog (with a read-only STAC API), webhooks, integration files, and integration export/import. Authenticate with a session cookie (POST /api/login) or a personal access token (Authorization: Bearer dit_...). Routes not listed here serve the web UI and are not a stable interface. Data access works with no AI configured."
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "Personal access token (dit_...)" },
      "cookie": { "type": "apiKey", "in": "cookie", "name": "di_session" }
    },
    "schemas": {
      "Filter": {
        "type": "array",
        "description": "Conjunction of column comparisons; the same vocabulary definitions use for inputs.",
        "items": {
          "type": "object",
          "required": ["column", "op", "value"],
          "properties": {
            "column": { "type": "string" },
            "op": { "type": "string", "enum": ["=", "!=", ">", ">=", "<", "<=", "in"] },
            "value": { "description": "Comparison value; an array for op=in" }
          }
        }
      },
      "ColumnSpec": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "number", "integer", "boolean", "date", "datetime", "geometry", "enum", "json"] },
          "units": { "type": "string" },
          "enumValues": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Trigger": {
        "type": "object",
        "description": "Replaces the whole trigger; omitted fields are cleared",
        "properties": {
          "cron": { "type": ["string", "null"], "description": "Standard 5-field cron, UTC" },
          "webhook": { "type": "boolean", "description": "Accept events at /hooks/{token}" },
          "webhookDelaySeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "description": "Batch window: the first event schedules a run this many seconds later and later events join it (webhook only; 0 runs at once)"
          }
        }
      },
      "AiLimits": {
        "type": "object",
        "properties": {
          "userDailyTokens": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Input plus output tokens one user may use per UTC day; null for no cap"
          },
          "deploymentDailyTokens": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Input plus output tokens all users together may use per UTC day; null for no cap"
          }
        }
      },
      "AccountPolicy": {
        "type": "object",
        "properties": {
          "passwordMaxAgeDays": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 3650,
            "description": "Days after which a password must be changed at next sign-in; null for no expiry"
          },
          "inactiveDisableDays": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 3650,
            "description": "Days without sign-in or API use after which an account is disabled; null for never"
          }
        }
      },
      "StacError": {
        "type": "object",
        "properties": { "code": { "type": "string", "enum": ["InvalidParameterValue", "NotFound"] }, "description": { "type": "string" } }
      }
    }
  },
  "security": [{ "bearer": [] }, { "cookie": [] }],
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Sign in with email and password; sets the session cookie",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "newPassword": { "type": "string", "description": "Replacement for an expired password; sets it and signs in" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ user: { email, role } }; sets the di_session cookie" },
          "400": { "description": "newPassword is shorter than 8 characters or equals the old password" },
          "401": { "description": "Bad credentials or locked; { error, code: \"password_expired\" } when the password has expired and no newPassword was sent" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "End the cookie session and clear the cookie",
        "security": [],
        "responses": { "200": { "description": "{ ok: true }" } }
      }
    },
    "/api/me": {
      "get": {
        "summary": "The signed-in user and the deployment's AI status",
        "responses": {
          "200": { "description": "{ user: { id, email, role }, ai: { provider, model, ackRequired } }" },
          "401": { "description": "Not signed in" }
        }
      }
    },
    "/api/tokens": {
      "get": {
        "summary": "List your personal access tokens: id, name, createdAt, lastUsedAt, expiresAt (never the secrets)",
        "responses": { "200": { "description": "Token list" } }
      },
      "post": {
        "summary": "Mint a personal access token; the secret is returned once",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string" }, "expiresDays": { "type": "integer" } }
              }
            }
          }
        },
        "responses": { "201": { "description": "{ token, note }; the token is shown once" }, "400": { "description": "Missing name" } }
      }
    },
    "/api/tokens/{id}": {
      "delete": {
        "summary": "Revoke one of your tokens",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Revoked" }, "404": { "description": "No such token" } }
      }
    },
    "/api/me/password": {
      "post": {
        "summary": "Change your own password, proving the current one",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": { "currentPassword": { "type": "string" }, "newPassword": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "{ ok }" }, "400": { "description": "Wrong current password or new password too short" } }
      }
    },
    "/api/users": {
      "get": { "summary": "List all users (admin)", "responses": { "200": { "description": "{ users }" } } },
      "post": {
        "summary": "Create a user with a generated password, returned once (admin)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "role"],
                "properties": { "email": { "type": "string" }, "role": { "enum": ["admin", "editor", "viewer"] } }
              }
            }
          }
        },
        "responses": { "201": { "description": "{ user, password }" }, "409": { "description": "Email already exists" } }
      }
    },
    "/api/users/{id}/password": {
      "post": {
        "summary": "Reset a user's password to a fresh generated one, returned once; clears any lockout (admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ password }" }, "404": { "description": "No such user" } }
      }
    },
    "/api/users/{id}/role": {
      "put": {
        "summary": "Change a user's role; refuses to demote the last active admin (admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["role"], "properties": { "role": { "enum": ["admin", "editor", "viewer"] } } }
            }
          }
        },
        "responses": {
          "200": { "description": "{ user }" },
          "404": { "description": "No such user" },
          "409": { "description": "Last active admin" }
        }
      }
    },
    "/api/users/{id}/disabled": {
      "put": {
        "summary": "Disable (revoking sessions) or enable a user; refuses to disable yourself or the last active admin (admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["disabled"], "properties": { "disabled": { "type": "boolean" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "{ user }" },
          "404": { "description": "No such user" },
          "409": { "description": "Last active admin" }
        }
      }
    },
    "/api/tables": {
      "get": {
        "summary": "List queryable tables with their declared column schemas",
        "responses": { "200": { "description": "{ tables: [{ tableId, integrationId, name, description, columns: ColumnSpec[] }] }" } }
      }
    },
    "/api/tables/{tableId}/rows": {
      "get": {
        "summary": "Filtered read over one table",
        "parameters": [
          { "name": "tableId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "where",
            "in": "query",
            "description": "URL-encoded JSON Filter (an array, or a single clause object)",
            "schema": { "type": "string" }
          },
          { "name": "columns", "in": "query", "description": "Comma-separated column ids", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "description": "column, column.asc, or column.desc", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 1000, "maximum": 10000 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["json", "csv", "geojson"], "default": "json" },
            "description": "geojson uses the first selected geometry column as the feature geometry"
          }
        ],
        "responses": {
          "200": { "description": "{ columns, rows } | CSV text | GeoJSON FeatureCollection" },
          "400": { "description": "Bad filter, column, order, or geojson without a geometry column" },
          "404": { "description": "Unknown table" }
        }
      }
    },
    "/api/tables/{tableId}/geometry": {
      "get": {
        "summary": "Geometry facts of a table for map framing",
        "parameters": [{ "name": "tableId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "{ geometryColumn: string | null, extent: [west, south, east, north] | null }" },
          "404": { "description": "Unknown table" }
        }
      }
    },
    "/api/tables/{tableId}/tiles/{z}/{x}/{y}.mvt": {
      "get": {
        "summary": "Display vector tile of a table: source layer \"features\", every column as a property, geometry simplified to the tile and at most 2048 features per tile, largest first",
        "parameters": [
          { "name": "tableId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "z", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "x", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "y", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "application/vnd.mapbox-vector-tile" },
          "400": { "description": "Tile query failed" },
          "404": { "description": "Unknown table or no geometry column" }
        }
      }
    },
    "/api/layers": {
      "get": {
        "summary": "Raster catalog: installed layers with band metadata, the current snapshot, promoted snapshots ({ id, observed_at, observed_end, sources }), masked, and mask_key",
        "responses": { "200": { "description": "{ layers: [...] }" } }
      }
    },
    "/api/layers/{id}": {
      "get": {
        "summary": "One layer in full (camelCase): bands, mask, current snapshot, snapshots, owning integration, source attribution, retentionDays, sizeBytes",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Layer detail" }, "404": { "description": "Unknown layer" } }
      }
    },
    "/api/layers/{id}/sample": {
      "get": {
        "summary": "Pixel value of a snapshot at a WGS84 lon/lat; null for nodata or outside the data",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "snapshot", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "lon", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "lat", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "band", "in": "query", "schema": { "type": "string" }, "description": "Band id; default the first band" }
        ],
        "responses": {
          "200": { "description": "{ value: number | null }" },
          "400": { "description": "Missing snapshot, lon, or lat" },
          "404": { "description": "Unknown snapshot or band" }
        }
      }
    },
    "/api/snapshots/{id}/download": {
      "get": {
        "summary": "Download one Cloud-Optimized GeoTIFF of a snapshot",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "source",
            "in": "query",
            "description": "0-based file ordinal within a multi-file snapshot",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": { "description": "image/tiff attachment, named <layer>_<snapshot>[_<ordinal>].tif" },
          "404": { "description": "Unknown snapshot, empty snapshot, ordinal past the last file, or file missing from the store" }
        }
      }
    },
    "/tiles/{layerId}/{snapshotId}/{z}/{x}/{y}.png": {
      "get": {
        "summary": "Rendered PNG map tile (XYZ, Web Mercator) of the layer's first band, snapshot-pinned and immutable",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "z", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "x", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "y", "in": "path", "required": true, "schema": { "type": "integer" } },
          {
            "name": "mask",
            "in": "query",
            "description": "0 draws everything the files cover; otherwise drawing is clipped to the layer's mask",
            "schema": { "type": "string", "enum": ["0"] }
          },
          {
            "name": "m",
            "in": "query",
            "description": "The layer's mask_key; ignored by the server, it changes the URL when the area is reshaped so caches do not serve a stale clip",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "PNG tile, cache-control immutable" }, "404": { "description": "Unknown snapshot or band" } }
      }
    },
    "/tiles/{layerId}/{snapshotId}/{bandId}/{z}/{x}/{y}.png": {
      "get": {
        "summary": "Rendered PNG map tile of one band, snapshot-pinned and immutable",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "bandId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "z", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "x", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "y", "in": "path", "required": true, "schema": { "type": "integer" } },
          {
            "name": "mask",
            "in": "query",
            "description": "0 draws everything the files cover; otherwise drawing is clipped to the layer's mask",
            "schema": { "type": "string", "enum": ["0"] }
          },
          {
            "name": "m",
            "in": "query",
            "description": "The layer's mask_key; ignored by the server, it changes the URL when the area is reshaped so caches do not serve a stale clip",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "PNG tile, cache-control immutable" }, "404": { "description": "Unknown snapshot or band" } }
      }
    },
    "/api/stac": {
      "get": {
        "summary": "STAC landing page: a Catalog with conformsTo and a child link per collection",
        "responses": { "200": { "description": "STAC Catalog" } }
      }
    },
    "/api/stac/conformance": {
      "get": { "summary": "STAC and OGC API Features conformance classes", "responses": { "200": { "description": "{ conformsTo }" } } }
    },
    "/api/stac/collections": {
      "get": {
        "summary": "One STAC Collection per installed raster layer",
        "parameters": [
          { "name": "lang", "in": "query", "description": "Locale of titles and descriptions; default en", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{ collections, links }" } }
      }
    },
    "/api/stac/collections/{layerId}": {
      "get": {
        "summary": "One STAC Collection",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "lang", "in": "query", "description": "Locale of titles and descriptions; default en", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "STAC Collection" }, "404": { "description": "StacError NotFound" } }
      }
    },
    "/api/stac/collections/{layerId}/items": {
      "get": {
        "summary": "Items (promoted snapshots) of a collection, newest first; follow the next link to page",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size; values above 1000 are lowered to 1000",
            "schema": { "type": "integer", "minimum": 1, "default": 100, "maximum": 1000 }
          },
          {
            "name": "datetime",
            "in": "query",
            "description": "RFC 3339 instant, or interval start/end with .. for an open bound; matches observation periods overlapping it",
            "schema": { "type": "string" }
          },
          {
            "name": "bbox",
            "in": "query",
            "description": "west,south,east,north (WGS84); matches intersecting footprints",
            "schema": { "type": "string" }
          },
          { "name": "token", "in": "query", "description": "Paging cursor from the next link", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection of STAC Items with numberReturned and links",
            "content": { "application/geo+json": {} }
          },
          "400": { "description": "StacError InvalidParameterValue" },
          "404": { "description": "StacError NotFound" }
        }
      }
    },
    "/api/stac/collections/{layerId}/items/{snapshotId}": {
      "get": {
        "summary": "One STAC Item; assets data (or data-0, data-1, ...) link to /api/snapshots/{id}/download",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "STAC Item", "content": { "application/geo+json": {} } },
          "404": { "description": "StacError NotFound" }
        }
      }
    },
    "/api/integrations": {
      "get": {
        "summary": "List installed integrations with last-run status",
        "responses": { "200": { "description": "{ integrations }" } }
      }
    },
    "/api/integrations/{id}": {
      "get": {
        "summary": "Integration detail: definition, version, enabled, status, the 50 most recent runs (with flags: data-quality findings, null when none), destination counts",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "IntegrationDetail" }, "404": { "description": "Unknown integration" } }
      }
    },
    "/api/integrations/{id}/run": {
      "post": {
        "summary": "Start a manual run (editor or admin). With files, pins file versions per slot (a revert or multi-slot replace) and queues behind a run in progress, merging into an already-queued run. With rebuild: true, runs cold (no previous state, empty /work) so everything in scope is produced again",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": { "type": "object", "additionalProperties": { "type": "string", "description": "versionId" } },
                  "rebuild": { "type": "boolean", "description": "Run cold; takes no files" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "{ runId, status: running | queued }" },
          "400": { "description": "A slot awaits its first upload, a pin names no live, accepted version of the slot, or rebuild is combined with files" },
          "409": { "description": "Without files: a run is already queued or running, or the integration is a draft" }
        }
      }
    },
    "/api/integrations/{id}/files": {
      "get": {
        "summary": "File slots with their versions, current version, bytes stored, and the runs that read each version. Filenames and uploader emails are null for viewers",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "{ slots: [{ slotId, declared, description, accept, bytesStored, versions: [{ id, version, filename, uploadedBy, uploadedAt, sizeBytes, sha256, current, purgedAt, runs }] }], maxUploadMb }"
          }
        }
      }
    },
    "/api/integrations/{id}/files/{slot}": {
      "put": {
        "summary": "Upload a new version of a file slot as a raw body (editor or admin). Checks run before the body is read; Expect: 100-continue is answered only after them. run=true (default) requires an installed, non-draft integration declaring the slot and accepting the extension, and starts or queues a run pinning the version; run=false only stores it",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slot", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "filename", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "run", "in": "query", "required": false, "schema": { "type": "boolean", "default": true } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
        },
        "responses": {
          "201": { "description": "{ version, run: { id, status } | null, runError? }" },
          "400": { "description": "Bad slot, filename, or extension; undeclared slot or unaccepted type with run=true" },
          "403": { "description": "Viewer" },
          "404": { "description": "Unknown integration" },
          "409": { "description": "run=true on a draft integration" },
          "413": { "description": "Larger than FILE_UPLOAD_MAX_MB (default 100)" },
          "507": { "description": "The file store's disk is full" }
        }
      }
    },
    "/api/integrations/{id}/files/{slot}/versions/{versionId}/download": {
      "get": {
        "summary": "Download one file version (editor or admin) as an inert attachment: application/octet-stream, nosniff, CSP sandbox, no-store",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slot", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "The file" },
          "403": { "description": "Viewer" },
          "404": { "description": "Unknown version" },
          "410": { "description": "Purged" }
        }
      }
    },
    "/api/integrations/{id}/versions": {
      "get": {
        "summary": "Definition version history: who changed what, when, with each version's AOI",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ versions }" }, "404": { "description": "Unknown integration" } }
      }
    },
    "/api/integrations/{id}/aoi": {
      "put": {
        "summary": "Change the area of interest (editor or admin); archives a new attributed definition version",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "description": "{mode: \"inherit\"|\"full\"} or {mode: \"box\", aoi: {bbox, countries?}}" } }
          }
        },
        "responses": { "200": { "description": "{ version }" }, "400": { "description": "Invalid mode or bbox" } }
      }
    },
    "/api/integrations/{id}/settings": {
      "put": {
        "summary": "Set the deployment's values for the definition's declared settings (editor or admin); a versioned definition edit. null restores a setting's default",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["values"],
                "properties": {
                  "values": {
                    "type": "object",
                    "additionalProperties": { "oneOf": [{ "type": "integer" }, { "type": "boolean" }, { "type": "string" }], "nullable": true }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ version }" },
          "400": { "description": "An undeclared setting, or a value outside its type, bounds, choices or pattern" },
          "403": { "description": "Viewer" },
          "404": { "description": "Unknown integration" }
        }
      }
    },
    "/api/integrations/{id}/trigger": {
      "put": {
        "summary": "Replace the schedule (editor or admin); a versioned definition edit. Cron is 5-field, UTC, validated",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Trigger" } } } },
        "responses": {
          "200": { "description": "{ version, trigger }" },
          "400": { "description": "Invalid cron or webhookDelaySeconds" },
          "403": { "description": "Viewer" },
          "404": { "description": "Unknown integration" }
        }
      }
    },
    "/api/integrations/{id}/enabled": {
      "put": {
        "summary": "Pause or resume scheduling (editor or admin); operational state, not versioned",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "description": "{enabled: boolean}" } } } },
        "responses": { "200": { "description": "{ enabled }" } }
      }
    },
    "/api/integrations/{id}/webhook-token": {
      "get": {
        "summary": "The webhook capability URL (editor or admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "{ token, path: /hooks/{token} }" },
          "403": { "description": "Viewer" },
          "404": { "description": "Unknown integration" }
        }
      },
      "post": {
        "summary": "Rotate the webhook token (admin); the old URL stops working immediately",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "{ token, path }" },
          "403": { "description": "Not an admin" },
          "404": { "description": "Unknown integration" }
        }
      }
    },
    "/api/integrations/{id}/export": {
      "get": {
        "summary": "The current definition as a JSON attachment (<id>.integration.json). A concrete AOI is stripped so the importer's default applies; an explicit aoi: null (full extent) is kept",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Integration definition" }, "404": { "description": "Unknown integration" } }
      }
    },
    "/api/integrations/import": {
      "post": {
        "summary": "Install an exported definition (editor or admin). Validates it and installs it paused for review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["id", "runtime", "code"], "description": "An integration definition as exported" }
            }
          }
        },
        "responses": {
          "200": { "description": "{ id, version, enabled: false }" },
          "400": { "description": "Not a definition, validation failure, or a destination another integration owns" },
          "403": { "description": "Viewer" },
          "409": { "description": "An integration with this id is installed" }
        }
      }
    },
    "/hooks/{token}": {
      "post": {
        "summary": "Webhook receiver. The token is the credential (no session or bearer). The body is stored verbatim as one event; the next run receives pending events oldest-first. A run is enqueued at once, or after trigger.webhookDelaySeconds with later events joining it; paused or draft integrations buffer events",
        "security": [],
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "description": "Any JSON value, at most 1 MB" } } }
        },
        "responses": {
          "202": { "description": "{ eventId }" },
          "400": { "description": "Malformed JSON" },
          "404": { "description": "Unknown token, or the integration does not accept webhooks" },
          "405": { "description": "Not POST" },
          "413": { "description": "Body over 1 MB" },
          "415": { "description": "Content-Type is not application/json" }
        }
      }
    },
    "/api/countries": {
      "get": {
        "summary": "Baked-in country bounding boxes (Natural Earth derived) for AOI pickers",
        "responses": { "200": { "description": "{ countries: [{iso3, name, bbox}] }" } }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Deployment settings, readable by any signed-in user",
        "responses": {
          "200": {
            "description": "{ settings: { default_aoi, site_title, locales }, supportedLocales: [{ code, name }], catalogTranslation }"
          }
        }
      }
    },
    "/api/settings/default_aoi": {
      "put": {
        "summary": "Set the deployment default AOI (admin)",
        "requestBody": { "content": { "application/json": { "schema": { "description": "{bbox, countries?, name?}" } } } },
        "responses": { "200": { "description": "{ default_aoi }" }, "400": { "description": "Invalid bbox or country codes" } }
      },
      "delete": {
        "summary": "Clear the deployment default AOI (admin)",
        "responses": { "200": { "description": "{ default_aoi: null }" } }
      }
    },
    "/api/settings/site_title": {
      "put": {
        "summary": "Set the deployment title (admin); empty or null restores the default",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "title": { "type": ["string", "null"], "maxLength": 120 } } }
            }
          }
        },
        "responses": {
          "200": { "description": "{ site_title }" },
          "400": { "description": "title is not a string" },
          "403": { "description": "Not an admin" }
        }
      }
    },
    "/api/settings/locales": {
      "put": {
        "summary": "Set the offered locales (admin); adding one starts a background catalog translation when AI is configured",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["locales"],
                "properties": { "locales": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ locales, added, catalogTranslation }" },
          "400": { "description": "Empty or unsupported locales" },
          "403": { "description": "Not an admin" }
        }
      }
    },
    "/api/settings/ai_limits": {
      "get": {
        "summary": "Daily AI token caps and today's deployment usage (admin)",
        "responses": { "200": { "description": "{ limits: AiLimits, usedToday: integer }" }, "403": { "description": "Not an admin" } }
      },
      "put": {
        "summary": "Set the daily AI token caps (admin); an omitted cap counts as null (no cap)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiLimits" } } } },
        "responses": {
          "200": { "description": "{ limits: AiLimits, usedToday: integer }" },
          "400": { "description": "A cap is not a positive integer or null" },
          "403": { "description": "Not an admin" }
        }
      }
    },
    "/api/settings/account_policy": {
      "get": {
        "summary": "Password expiry and inactive-account disabling policy (admin); both off by default",
        "responses": { "200": { "description": "{ policy: AccountPolicy }" }, "403": { "description": "Not an admin" } }
      },
      "put": {
        "summary": "Set the account policy (admin); an omitted rule counts as null (off)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountPolicy" } } } },
        "responses": {
          "200": { "description": "{ policy: AccountPolicy }" },
          "400": { "description": "A rule is not a whole number of days from 1 to 3650 or null" },
          "403": { "description": "Not an admin" }
        }
      }
    },
    "/api/library": {
      "get": {
        "summary": "Browsable integration library with per-entry install/update status",
        "responses": { "200": { "description": "{ entries }" } }
      }
    },
    "/api/library/{id}/install": {
      "post": {
        "summary": "Install or update a library entry (editor or admin); updates keep the installed aoi/trigger/limits",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "description": "{runNow?: boolean}" } } } },
        "responses": { "200": { "description": "{ version, runId }" }, "404": { "description": "Unknown library entry" } }
      }
    }
  }
}
