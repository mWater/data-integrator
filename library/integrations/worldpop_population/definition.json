{
  "id": "worldpop_population",
  "name": "WorldPop population (1km, UN-adjusted, 2020)",
  "description": "Gridded population counts per ~1km pixel for one country, UN-adjusted 2020. Country selectable via params.country (ISO3), default MDG.",
  "source": {
    "name": "WorldPop Global Population 2000-2020 1km UNadj",
    "url": "https://www.worldpop.org",
    "provider": "WorldPop, University of Southampton",
    "license": "CC-BY-4.0",
    "documentation": "https://hub.worldpop.org/geodata/listing?id=75"
  },
  "trigger": { "cron": "0 0 1 * *" },
  "runtime": "python3.12",
  "limits": { "timeoutMs": 900000, "memoryMb": 2048 },
  "destinations": [
    {
      "kind": "raster",
      "layerId": "worldpop_population",
      "name": "Population",
      "temporality": "current-only",
      "bands": [
        {
          "id": "pop",
          "name": "Population count",
          "units": "people per pixel",
          "rendering": {
            "resampling": "nearest",
            "defaultRange": { "min": 0, "max": 2000 },
            "colorMap": [
              { "value": 0, "color": "#00000000" },
              { "value": 1, "color": "#ffffcc" },
              { "value": 5, "color": "#ffeda0" },
              { "value": 25, "color": "#feb24c" },
              { "value": 100, "color": "#fc4e2a" },
              { "value": 500, "color": "#e31a1c" },
              { "value": 2000, "color": "#800026" }
            ]
          }
        }
      ]
    }
  ],
  "code": "",
  "contract": 2
}
